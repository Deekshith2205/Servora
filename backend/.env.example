# LLM provider credentials — copy this file to .env and fill in your own key.
# Never commit the real .env file.
#
# Two providers are supported (see app/llm.py) — pick ONE:
#
# 1. Anthropic (default):
#      LLM_PROVIDER=anthropic
#      ANTHROPIC_API_KEY=sk-ant-...
#      LLM_MODEL=claude-opus-5
#
# 2. Google Gemini — a free-tier fallback (Google AI Studio: no billing
#    required for the free tier). Useful when no Anthropic credit is
#    available:
#      LLM_PROVIDER=gemini
#      GOOGLE_API_KEY=...        (get one at https://aistudio.google.com/apikey)
#      LLM_MODEL=gemini-2.5-flash
#
# LLM_MODEL must match whichever provider LLM_PROVIDER selects — it's a
# single generic setting, not provider-specific.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=claude-opus-5

# Database
DATABASE_URL=sqlite:///./servora.db

# CORS — the Vite dev server origin
FRONTEND_ORIGIN=http://localhost:5173

# Real "Sign in with Google" — a Google OAuth Client ID, created at
# https://console.cloud.google.com/auth/clients (Application type: Web
# application). Only the Client ID is ever needed here, never the client
# secret — this app verifies the ID token Google's own Identity Services
# JS library returns, it never exchanges an authorization code server-
# side. Must match frontend/.env's VITE_GOOGLE_CLIENT_ID exactly. Leave
# blank to leave the feature off — the button shows "not configured."
GOOGLE_CLIENT_ID=
