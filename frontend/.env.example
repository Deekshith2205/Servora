VITE_API_BASE_URL=http://localhost:8000

# Real "Sign in with Google" — a Google OAuth Client ID (not the secret;
# see backend/.env.example for why the secret is never needed at all).
# Create one at https://console.cloud.google.com/auth/clients — must
# match the same value as backend/.env's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
